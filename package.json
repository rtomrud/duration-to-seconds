{
  "name": "duration-to-seconds",
  "version": "2.0.0",
  "description": "Converts an ISO 8601 duration to seconds",
  "keywords": [
    "ISO",
    "ISO 8601",
    "convert",
    "date",
    "duration",
    "seconds",
    "time",
    "unit"
  ],
  "homepage": "https://github.com/rtomrud/duration-to-seconds#readme",
  "bugs": {
    "url": "https://github.com/rtomrud/duration-to-seconds/issues"
  },
  "license": "MIT",
  "author": "Artem Rudenko <rtomrud@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtomrud/duration-to-seconds.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.2",
      "onFail": "download"
    }
  }
}
